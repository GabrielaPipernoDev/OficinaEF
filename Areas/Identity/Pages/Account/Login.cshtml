@page
@model LoginModel



@{
    ViewData["Title"] = "Login - Angel's";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: Arial, Helvetica, sans-serif;
        background-color: #d9ddef;
    }

    .login-container {
        width: 94%;
        max-width: 1700px;
        min-height: 760px;
        height: calc(100vh - 20px);
        margin: 10px auto;
        display: flex;
        background: white;
        overflow: hidden;
        border-radius: 3px;
    }

    /* LADO ESQUERDO */

    .login-left {
        width: 48%;
        background-color: #ffffff;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 50px;
    }

    .login-content {
        width: 100%;
        max-width: 390px;
    }

    .logo {
        text-align: center;
        margin-bottom: 40px;
    }

    .logo-icon {
        font-size: 28px;
        background-color: #fff5f8;
        padding: 13px;
        border-radius: 12px;
        display: inline-block;
        margin-bottom: 15px;
    }

    .logo h1 {
        font-size: 32px;
        color: #29232a;
        margin-bottom: 10px;
        letter-spacing: 1px;
    }

    .logo p {
        font-size: 14px;
        color: #89818a;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-size: 13px;
        color: #39313a;
        margin-bottom: 8px;
    }

    .form-group input {
        width: 100%;
        height: 45px;
        padding: 12px;
        border: 1px solid #ded9de;
        outline: none;
        font-size: 14px;
        transition: 0.3s;
    }

    .form-group input:focus {
        border-color: #d59aaa;
        box-shadow: 0 0 5px #f2d5df;
    }

    .options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        margin: 20px 0 28px;
        gap: 10px;
    }

    .remember {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #69616b;
    }

    .remember input {
        accent-color: #b8798e;
    }

    .options a,
    .signup a {
        color: #8e5368;
        font-weight: bold;
        text-decoration: none;
    }

    .options a:hover,
    .signup a:hover {
        text-decoration: underline;
    }

    .btn-login {
        width: 100%;
        height: 46px;
        background-color: #29232a;
        color: white;
        border: none;
        cursor: pointer;
        font-size: 14px;
        transition: 0.3s;
    }

    .btn-login:hover {
        background-color: #a66c80;
    }

    .btn-google {
        width: 100%;
        height: 46px;
        margin-top: 13px;
        background-color: white;
        border: 1px solid #ded9de;
        cursor: pointer;
        font-size: 13px;
        color: #39313a;
        transition: 0.3s;
    }

    .btn-google:hover {
        background-color: #fff7fa;
    }

    .signup {
        text-align: center;
        margin-top: 30px;
        font-size: 13px;
        color: #89818a;
    }

    /* LADO DIREITO */

    .login-right {
        width: 52%;
        min-height: 760px;

        background-image:
            linear-gradient(
                to top,
                rgba(20, 12, 18, 0.78),
                rgba(20, 12, 18, 0.05)
            ),
            url('/images/login-nyc.jpg');

        background-size: cover;
        background-position: center;

        display: flex;
        align-items: flex-end;
        padding: 65px;
        color: white;
    }

    .image-content {
        max-width: 560px;
        margin-bottom: 35px;
    }

    .image-content h2 {
        font-size: 48px;
        line-height: 1.18;
        margin-bottom: 22px;
        font-weight: 600;
    }

    .image-content p {
        font-size: 15px;
        line-height: 1.8;
        margin-bottom: 24px;
        color: #f4edf0;
    }

    .image-content a {
        color: white;
        font-size: 13px;
        font-weight: bold;
        text-decoration: none;
    }

    .image-content a:hover {
        text-decoration: underline;
    }

    /* RESPONSIVIDADE */

    @@media (max-width: 1000px) {
        .login-container {
            width: 96%;
        }

        .login-left {
            padding: 30px;
        }

        .login-right {
            padding: 35px;
        }

        .image-content h2 {
            font-size: 36px;
        }
    }

    @@media (max-width: 650px) {
        .login-container {
            width: 100%;
            height: auto;
            min-height: 100vh;
            margin: 0;
        }

        .login-left {
            width: 100%;
            min-height: 100vh;
            padding: 25px;
        }

        .login-right {
            display: none;
        }
    }
</style>

<div class="login-container">

    <!-- LADO ESQUERDO: LOGIN -->

    <div class="login-left">

        <div class="login-content">

            <div class="logo">
                <div class="logo-icon">💘</div>

                <h1>Angel's</h1>

                <p>O encanto de Sakura em cada detalhe.</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="Email">E-mail</label>

                    <input type="email"
                           id="Email"
                           name="Email"
                           placeholder="Digite seu e-mail"
                           required />
                </div>

                <div class="form-group">
                    <label for="Password">Senha</label>

                    <input type="password"
                           id="Password"
                           name="Password"
                           placeholder="Digite sua senha"
                           required />
                </div>

                <div class="options">

                    <label class="remember">
                        <input type="checkbox" name="RememberMe" />
                        Lembrar de mim por 30 dias
                    </label>

                    <a asp-controller="Account"
                       asp-action="ForgotPassword">
                        Esqueceu a senha?
                    </a>

                </div>

                <button type="submit" class="btn-login">
                    Entrar
                </button>

                <button type="button" class="btn-google">
                    🌐 &nbsp; Entrar com Google
                </button>

                <div class="signup">
                    Ainda não possui uma conta?

                    <a asp-controller="Account"
                       asp-action="Register">
                        Cadastre-se
                    </a>
                </div>

            </form>

        </div>

    </div>

    <!-- LADO DIREITO: IMAGEM E DIVULGAÇÃO -->

    <div class="login-right">

        <div class="image-content">

            <h2>
                A delicadeza de Sakura.
                O charme de Nova York.
            </h2>

            <p>
                Descubra uma coleção exclusiva de joias
                inspiradas na beleza das flores de cerejeira.
                Peças delicadas, elegantes e cheias de significado,
                diretamente do universo encantador de NYC.
            </p>

            <a href="#">
                Conheça nossa coleção ↗
            </a>

        </div>

    </div>

</div>
